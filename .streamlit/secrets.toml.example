# Copy this file to secrets.toml and fill in your API key.
# For Streamlit Community Cloud: paste this into the Secrets section
# in your app's settings (https://share.streamlit.io).
# For Posit Connect Cloud: do NOT use this file — set ANTHROPIC_API_KEY
# as an environment variable in the content's Advanced settings instead.

ANTHROPIC_API_KEY = "sk-ant-api03-..."

# Optional: password-protect the AI interpretation feature so only
# people you share the password with can trigger paid API calls.
# Leave unset to make the feature available to anyone with the app.
AI_PASSWORD = "choose-a-password"
